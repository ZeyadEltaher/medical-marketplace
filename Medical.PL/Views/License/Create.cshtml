@using Medical.DAL.Constants
@model Medical.BLL.ViewModels.License.LicenseCreateViewModel

@{
    ViewData["Title"] = "Add License";
}

<style>
    .create {
        --c-ink: var(--medical-dark, #1c2733);
        --c-muted: var(--medical-muted, #4f5b66);
        --c-line: var(--medical-border, #d4d6cf);
        --c-tint: var(--medical-surface, #e8e8e2);
        --c-card: var(--medical-card, #fafaf8);
        --c-accent: var(--medical-primary, #1d5c63);
        --c-error: #a63232;

        color: var(--c-ink);
        font-size: 1.0625rem;
        max-width: 60rem;
    }

    .create .crumbs {
        margin-bottom: 1.25rem;
        color: var(--c-muted);
        font-size: 1rem;
    }

    .create .crumbs a {
        color: var(--c-accent);
        font-weight: 600;
        text-underline-offset: 3px;
    }

    .create .crumbs span {
        margin: 0 .4rem;
    }

    .create h1 {
        font-size: 2rem;
        font-weight: 700;
        letter-spacing: -.01em;
        margin: 0 0 .3rem;
    }

    .create .lead-text {
        color: var(--c-muted);
        margin: 0 0 1.5rem;
        line-height: 1.6;
    }

    .create .panel {
        background: var(--c-card);
        border: 1px solid var(--c-line);
        border-top: 3px solid var(--c-accent);
        border-radius: 4px;
    }

    .create .section-title {
        margin: 0;
        padding: .8rem 1.5rem;
        font-size: .875rem;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: var(--c-muted);
        background: var(--c-tint);
        border-top: 1px solid var(--c-line);
        border-bottom: 1px solid var(--c-line);
    }

    .create .section-title:first-child {
        border-top: 0;
    }

    .create .section-body {
        padding: 1.4rem 1.5rem 1.6rem;
    }

    .create .req-note {
        padding: .9rem 1.5rem;
        color: var(--c-muted);
        font-size: 1rem;
    }

    .create .req {
        color: var(--c-error);
        font-weight: 700;
        margin-left: .15rem;
    }

    .create .field-label {
        display: block;
        margin-bottom: .35rem;
        font-size: 1rem;
        font-weight: 600;
    }

    .create .form-control-custom,
    .create .form-select-custom {
        display: block;
        width: 100%;
        min-height: 48px;
        padding: .5rem .8rem;
        border: 1px solid #b4bbb9;
        border-radius: 4px;
        background-color: var(--c-card);
        font-size: 1.0625rem;
        color: var(--c-ink);
    }

    .create textarea.form-control-custom {
        min-height: 110px;
        resize: vertical;
        line-height: 1.5;
    }

    .create .form-control-custom:focus,
    .create .form-select-custom:focus {
        border-color: var(--c-accent);
        box-shadow: 0 0 0 3px rgba(29, 92, 99, .18);
        outline: 0;
    }

    .create .input-validation-error {
        border-color: var(--c-error) !important;
    }

    .create .input-group .form-control-custom {
        border-top-right-radius: 0;
        border-bottom-right-radius: 0;
    }

    .create .input-group-text {
        border: 1px solid #b4bbb9;
        border-left: 0;
        border-radius: 0 4px 4px 0;
        background: var(--c-tint);
        color: var(--c-muted);
        font-weight: 600;
        font-size: 1rem;
    }

    .create .field-error {
        display: block;
        margin-top: .3rem;
        color: var(--c-error);
        font-size: .92rem;
    }

    .create .help-text {
        margin: .35rem 0 0;
        color: var(--c-muted);
        font-size: .95rem;
    }

    .create .validation-summary-valid {
        display: none;
    }

    .create .form-error {
        margin-bottom: 1.25rem;
        padding: .7rem .9rem;
        border: 1px solid #e3b9b9;
        border-left: 3px solid var(--c-error);
        border-radius: 4px;
        background: #f8ecec;
        color: #6f2222;
        font-size: 1rem;
    }

    .create .form-error ul {
        margin: 0;
        padding-left: 1.1rem;
    }

    .create .check-row {
        display: flex;
        gap: .75rem;
        align-items: flex-start;
    }

    .create .check-row .form-check-input {
        width: 1.25rem;
        height: 1.25rem;
        margin-top: .2rem;
        border-color: #8f9a96;
    }

    .create .check-row .form-check-input:checked {
        background-color: var(--c-accent);
        border-color: var(--c-accent);
    }

    .create .check-row .form-check-input:focus {
        border-color: var(--c-accent);
        box-shadow: 0 0 0 3px rgba(29, 92, 99, .18);
    }

    .create .check-row label {
        font-weight: 600;
    }

    /* File upload */

    .create .upload {
        width: 100%;
    }

    .create .upload-input {
        position: absolute;
        width: 1px;
        height: 1px;
        opacity: 0;
        overflow: hidden;
    }

    .create .upload-box {
        display: flex;
        align-items: center;
        gap: .9rem;
        width: 100%;
        min-height: 86px;
        padding: 1rem 1.1rem;
        border: 1px dashed #9da8a4;
        border-radius: 4px;
        background: var(--c-card);
        color: var(--c-ink);
        cursor: pointer;
        transition: border-color .15s ease, background-color .15s ease;
    }

    .create .upload-box:hover {
        border-color: var(--c-accent);
        background: var(--c-tint);
    }

    .create .upload-input:focus + .upload-box {
        border-color: var(--c-accent);
        box-shadow: 0 0 0 3px rgba(29, 92, 99, .18);
    }

    .create .upload-icon {
        flex: 0 0 auto;
        color: var(--c-accent);
    }

    .create .upload-text {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .create .upload-title {
        color: var(--c-ink);
        font-weight: 600;
        word-break: break-all;
    }

    .create .upload-sub {
        margin-top: .2rem;
        color: var(--c-muted);
        font-size: .92rem;
    }

    .create .actions {
        display: flex;
        flex-direction: column-reverse;
        gap: .6rem;
        justify-content: flex-end;
        padding: 1.1rem 1.5rem;
        border-top: 1px solid var(--c-line);
        background: var(--c-tint);
    }

    .create .actions .btn-medical,
    .create .actions .btn-outline-medical {
        font-size: 1.0625rem;
        padding: .6rem 1.4rem;
        text-align: center;
    }

    @@media (min-width: 576px) {
        .create .actions {
            flex-direction: row;
        }
    }

    @@media (max-width: 575.98px) {
        .create h1 {
            font-size: 1.6rem;
        }

        .create .section-body,
        .create .section-title,
        .create .req-note,
        .create .actions {
            padding-left: 1rem;
            padding-right: 1rem;
        }
    }
</style>

<div class="create">

    <nav class="crumbs" aria-label="Breadcrumb">
        <a asp-controller="License" asp-action="List">&larr; Licenses</a>
        <span>/</span>
        Add license
    </nav>

    <h1>Add product license</h1>

    <p class="lead-text">
        Enter the official details exactly as they appear on the license document.
    </p>

    <form asp-controller="License"
          asp-action="Create"
          method="post"
          enctype="multipart/form-data">

        <div asp-validation-summary="ModelOnly"
             class="form-error"
             role="alert">
        </div>

        <input type="hidden" asp-for="ModelId" />
        <input type="hidden" asp-for="CachedDocumentFileName" />

        <div class="panel">

            <div class="req-note">
                Fields marked with <span class="req">*</span> are required.
            </div>

            <!-- Product -->
            <h2 class="section-title">Product</h2>

            <div class="section-body">
                <div class="row g-3">

                    <div class="col-12 col-md-6">
                        <label asp-for="ProductName" class="field-label">
                            Product name<span class="req">*</span>
                        </label>

                        <select asp-for="ProductName"
                                class="form-select form-select-custom">

                            <option value="">Select product</option>

                            @foreach (string productName in Model.ProductsNames)
                            {
                                <option value="@productName">
                                    @productName
                                </option>
                            }

                        </select>

                        <span asp-validation-for="ProductName"
                              class="field-error">
                        </span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="LicenseCategory" class="field-label">
                            License category<span class="req">*</span>
                        </label>

                        <select asp-for="LicenseCategory"
                                class="form-select form-select-custom">

                            <option value="">Select category</option>

                            @foreach (LicenseCategory category in Enum.GetValues<LicenseCategory>())
                            {
                                <option value="@category">
                                    @category
                                </option>
                            }

                        </select>

                        <span asp-validation-for="LicenseCategory"
                              class="field-error">
                        </span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="TradeName" class="field-label">
                            Trade name<span class="req">*</span>
                        </label>

                        <input asp-for="TradeName"
                               class="form-control form-control-custom"
                               placeholder="Registered trade name" />

                        <span asp-validation-for="TradeName"
                              class="field-error">
                        </span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="DosageForm" class="field-label">
                            Dosage form<span class="req">*</span>
                        </label>

                        <input asp-for="DosageForm"
                               class="form-control form-control-custom"
                               placeholder="e.g. Tablet, Capsule, Syrup" />

                        <span asp-validation-for="DosageForm"
                              class="field-error">
                        </span>
                    </div>

                    <div class="col-12">
                        <label asp-for="ActiveIngredients" class="field-label">
                            Active ingredients<span class="req">*</span>
                        </label>

                        <textarea asp-for="ActiveIngredients"
                                  class="form-control form-control-custom"
                                  placeholder="List the active ingredients"></textarea>

                        <span asp-validation-for="ActiveIngredients"
                              class="field-error">
                        </span>
                    </div>

                </div>
            </div>

            <!-- Registration -->
            <h2 class="section-title">Registration</h2>

            <div class="section-body">
                <div class="row g-3">

                    <div class="col-12 col-md-6">
                        <label asp-for="RegistrationNumber" class="field-label">
                            Registration number<span class="req">*</span>
                        </label>

                        <input asp-for="RegistrationNumber"
                               class="form-control form-control-custom"
                               placeholder="Registration number" />

                        <span asp-validation-for="RegistrationNumber"
                              class="field-error">
                        </span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="CurrentOwnerCompany" class="field-label">
                            Current owner company<span class="req">*</span>
                        </label>

                        <input asp-for="CurrentOwnerCompany"
                               class="form-control form-control-custom"
                               placeholder="Company or organization name" />

                        <span asp-validation-for="CurrentOwnerCompany"
                              class="field-error">
                        </span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="IssueDate" class="field-label">
                            Issue date<span class="req">*</span>
                        </label>

                        <input asp-for="IssueDate"
                               type="date"
                               class="form-control form-control-custom" />

                        <span asp-validation-for="IssueDate"
                              class="field-error">
                        </span>
                    </div>

                    <div class="col-12 col-md-6">
                        <label asp-for="ExpiryDate" class="field-label">
                            Expiry date<span class="req">*</span>
                        </label>

                        <input asp-for="ExpiryDate"
                               type="date"
                               class="form-control form-control-custom" />

                        <span asp-validation-for="ExpiryDate"
                              class="field-error">
                        </span>
                    </div>

                </div>
            </div>

            <!-- Listing -->
            <h2 class="section-title">Listing</h2>

            <div class="section-body">
                <div class="row g-3">

                    <div class="col-12 col-md-6">
                        <label asp-for="AskingPrice" class="field-label">
                            Asking price<span class="req">*</span>
                        </label>

                        <div class="price-field">
                            <input asp-for="AskingPrice"
                                   type="text"
                                   inputmode="decimal"
                                   autocomplete="off"
                                   class="form-control-custom"
                                   placeholder="0.00" />

                            <span class="price-unit">
                                EGP
                            </span>
                        </div>

                        <span asp-validation-for="AskingPrice"
                              class="field-error">
                        </span>
                    </div>

                </div>
            </div>

            <!-- License document -->
            <h2 class="section-title">
                License document
            </h2>

            <div class="section-body">

                <label asp-for="LicenseDocument"
                       class="field-label">
                    Upload document<span class="req">*</span>
                </label>

                <div id="dropZone"
                     class="upload"
                     data-saved="@Model.CachedDocumentFileName">

                    <input asp-for="LicenseDocument"
                           type="file"
                           class="upload-input"
                           aria-describedby="fileHelp fileError"
                           accept=".pdf,.jpg,.jpeg,.png,.webp,application/pdf,image/jpeg,image/png,image/webp" />

                    <label for="LicenseDocument"
                           class="upload-box">

                        <svg class="upload-icon"
                             width="28"
                             height="28"
                             viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8"
                             stroke-linecap="round"
                             stroke-linejoin="round"
                             aria-hidden="true">

                            <path d="M12 16V4m0 0l-4 4m4-4l4 4" />
                            <path d="M4 16v3a1 1 0 001 1h14a1 1 0 001-1v-3" />

                        </svg>

                        <span class="upload-text">

                            <span id="uploadTitle"
                                  class="upload-title">

                                @(string.IsNullOrEmpty(Model.CachedDocumentFileName)
                                    ? "Click to choose a file or drag it here"
                                    : Model.CachedDocumentFileName)

                            </span>

                            <span id="uploadSub"
                                  class="upload-sub">

                                @(string.IsNullOrEmpty(Model.CachedDocumentFileName)
                                    ? "PDF, JPG, PNG or WebP, 10 KB to 5 MB"
                                    : "Click to replace this file")

                            </span>

                        </span>

                    </label>
                </div>

                <span id="fileError"
                      class="field-error d-none"
                      role="alert">
                </span>

                <span asp-validation-for="LicenseDocument"
                      class="field-error">
                </span>

                <span asp-validation-for="CachedDocumentFileName"
                      class="field-error">
                </span>

            </div>

            <!-- Actions -->
            <div class="actions">

                <a asp-controller="License"
                   asp-action="List"
                   class="btn btn-outline-medical">
                    Cancel
                </a>

                <button type="submit"
                        class="btn btn-medical">
                    Submit license
                </button>

            </div>

        </div>
    </form>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const fileInput = document.getElementById("LicenseDocument");
            const fileError = document.getElementById("fileError");
            const uploadTitle = document.getElementById("uploadTitle");
            const uploadSub = document.getElementById("uploadSub");
            const dropZone = document.getElementById("dropZone");

            if (!fileInput || !fileError || !uploadTitle || !uploadSub || !dropZone) {
                return;
            }

            const savedName = dropZone.dataset.saved || "";

            const emptyTitle =
                "Click to choose a file or drag it here";

            const emptySub =
                "PDF, JPG, PNG or WebP, 10 KB to 5 MB";

            const savedSub =
                "Click to replace this file";


            function showSavedFile() {
                if (savedName) {
                    uploadTitle.textContent = savedName;
                    uploadSub.textContent = savedSub;
                }
                else {
                    uploadTitle.textContent = emptyTitle;
                    uploadSub.textContent = emptySub;
                }
            }


            function showSelectedFile(file) {
                uploadTitle.textContent = file.name;
                uploadSub.textContent = savedSub;
            }


            function showError(message) {
                fileError.textContent = message;
                fileError.classList.remove("d-none");

                fileInput.value = "";

                showSavedFile();
            }


            fileInput.addEventListener("change", function () {

                fileError.textContent = "";
                fileError.classList.add("d-none");

                const file = this.files[0];

                if (!file) {
                    showSavedFile();
                    return;
                }

                // الحد الأدنى للحجم (10 KB)
                if (file.size < 10 * 1024) {
                    showError(
                        "The selected file must be at least 10 KB."
                    );
                    return;
                }

                // الحد الأقصى للحجم (5 MB)
                if (file.size > 5 * 1024 * 1024) {
                    showError(
                        "The selected file is larger than 5 MB."
                    );
                    return;
                }

                const allowed = [
                    "application/pdf",
                    "image/jpeg",
                    "image/png",
                    "image/webp"
                ];

                if (!allowed.includes(file.type)) {
                    showError(
                        "Please select a PDF, JPG, PNG or WebP file."
                    );
                    return;
                }

                showSelectedFile(file);
            });

            showSavedFile();

        });
    </script>
}