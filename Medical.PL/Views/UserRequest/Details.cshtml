@using Medical.DAL.Constants
@model Medical.BLL.ViewModels.UserRequest.RequestDetailsViewModel

@{
    ViewData["Title"] = "Transfer Request Details";

    bool isBuyer = ViewBag.IsBuyer == true;
    bool isSeller = ViewBag.IsSeller == true;

    string requestStatusClass = Model.Status switch
    {
        RequestStatus.Pending => "warn",
        RequestStatus.Approved => "ok",
        RequestStatus.Rejected => "bad",
        RequestStatus.Cancelled => "off",
        _ => "off"
    };

    string requestStatusText = Model.Status switch
    {
        RequestStatus.Pending => "Pending",
        RequestStatus.Approved => "Approved",
        RequestStatus.Rejected => "Rejected",
        RequestStatus.Cancelled => "Cancelled",
        _ => "Unknown"
    };

    string licenseStatusClass = Model.LicenseStatus switch
    {
        LicenseStatus.Approved => "ok",
        LicenseStatus.Rejected => "bad",
        LicenseStatus.Pending => "warn",
        _ => "off"
    };

    string licenseStatusText = Model.LicenseStatus?.ToString() ?? "Unknown";

    // Progress of the request, derived from its status
    string step2State = Model.Status switch
    {
        RequestStatus.Pending => "current",
        RequestStatus.Approved => "done",
        RequestStatus.Rejected => "bad",
        RequestStatus.Cancelled => "off",
        _ => "todo"
    };

    string step2Text = Model.Status switch
    {
        RequestStatus.Pending => "Waiting for the seller to respond",
        RequestStatus.Approved => "Approved by the seller",
        RequestStatus.Rejected => "Rejected by the seller",
        RequestStatus.Cancelled => "Cancelled by the buyer",
        _ => "Status unknown"
    };

    string step3State = Model.Status == RequestStatus.Approved ? "done"
        : Model.Status == RequestStatus.Pending ? "todo" : "skip";

    string step3Text = Model.Status switch
    {
        RequestStatus.Approved => "License moves to the buyer",
        RequestStatus.Pending => "Happens once the seller approves",
        _ => "Not applicable"
    };

    // Ownership only changes once the request is approved
    bool isApproved = Model.Status == RequestStatus.Approved;
    string sellerRole = isApproved ? "previous owner" : "current owner";
    string buyerRole = isApproved ? "new owner" : "requester";

    string Mark(string state, int number) => state switch
    {
        "done" => "\u2713",
        "bad" => "\u2715",
        "off" => "\u2013",
        "skip" => "\u2013",
        _ => number.ToString()
    };
}

<style>
    .rq {
        --r-ink: var(--medical-dark, #1c2733);
        --r-muted: var(--medical-muted, #4f5b66);
        --r-line: var(--medical-border, #d4d6cf);
        --r-tint: var(--medical-surface, #e8e8e2);
        --r-card: var(--medical-card, #fafaf8);
        --r-accent: var(--medical-primary, #1d5c63);
        --r-clay: #a8643a;
        --r-ok: #1f6b3a;
        --r-warn: #96501f;
        --r-bad: #a63232;
        color: var(--r-ink);
        font-size: 1.0625rem;
    }

    .rq .back { display: inline-block; margin-bottom: 1.25rem; color: var(--r-accent); font-weight: 600; text-underline-offset: 3px; }

    .rq .page-head { display: flex; flex-direction: column; gap: 1rem; margin-bottom: 1.5rem; }
    .rq .eyebrow { display: block; margin-bottom: .3rem; color: var(--r-muted); font-size: .9rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }
    .rq h1 { font-size: 2rem; font-weight: 700; letter-spacing: -.01em; margin: 0 0 .3rem; overflow-wrap: anywhere; }
    .rq .lead-text { margin: 0; color: var(--r-muted); }

    .rq .tag {
        display: inline-block; padding: .1rem .65rem; border: 1px solid var(--r-line); border-radius: 3px;
        font-size: .95rem; font-weight: 600; white-space: nowrap; color: var(--r-muted); background: var(--r-card);
    }
    .rq .tag.big { padding: .25rem .9rem; font-size: 1.05rem; }
    .rq .tag.ok   { color: var(--r-ok);   border-color: #b9dcc5; background: #f1f8f3; }
    .rq .tag.warn { color: var(--r-warn); border-color: #e6c9b3; background: #fbf3ec; }
    .rq .tag.bad  { color: var(--r-bad);  border-color: #e3b9b9; background: #f8ecec; }
    .rq .tag.off  { color: var(--r-muted); background: var(--r-tint); }

    .rq .panel { background: var(--r-card); border: 1px solid var(--r-line); border-top: 3px solid var(--r-accent); border-radius: 4px; }
    .rq .panel.warn { border-top-color: #b9743f; }
    .rq .panel.bad  { border-top-color: var(--r-bad); }
    .rq .panel.off  { border-top-color: #8f9a96; }
    .rq h2 { font-size: .875rem; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--r-muted); margin: 0; }

    /* The transfer: seller -> buyer */
    .rq .flow { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 1.5rem; padding: 1.75rem 1.5rem; }
    .rq .party { padding: 1.1rem 1.25rem; background: var(--r-tint); border: 1px solid var(--r-line); border-left: 3px solid var(--r-accent); border-radius: 4px; min-width: 0; }
    .rq .party.buyer { border-left-color: var(--r-clay); }
    .rq .party-role { display: block; margin-bottom: .2rem; color: var(--r-muted); font-size: .95rem; }
    .rq .party-name { display: block; font-size: 1.35rem; font-weight: 700; line-height: 1.25; overflow-wrap: anywhere; }

    .rq .flow-mid { text-align: center; min-width: 9rem; }
    .rq .flow-price { display: block; font-size: 1.6rem; font-weight: 700; letter-spacing: -.01em; white-space: nowrap; }
    .rq .flow-price small { color: var(--r-muted); font-size: 1rem; font-weight: 500; }
    .rq .flow-cap { display: block; color: var(--r-muted); font-size: .95rem; }
    .rq .flow-arrow { position: relative; display: block; height: 2px; margin: .75rem 0; background: var(--r-accent); }
    .rq .flow-arrow::after {
        content: ""; position: absolute; right: 0; top: -5px; width: 10px; height: 10px;
        border-top: 2px solid var(--r-accent); border-right: 2px solid var(--r-accent); transform: rotate(45deg);
    }

    /* Progress of the request */
    .rq .stepper { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--r-line); }
    .rq .step { padding: 1.25rem 1.5rem; border-right: 1px solid var(--r-line); }
    .rq .step:last-child { border-right: 0; }
    .rq .marker {
        display: grid; place-items: center; width: 30px; height: 30px; margin-bottom: .7rem; border-radius: 4px;
        border: 1px solid var(--r-line); background: var(--r-card); color: var(--r-muted); font-weight: 700;
    }
    .rq .step.done .marker { background: var(--r-accent); border-color: var(--r-accent); color: var(--r-card); }
    .rq .step.current .marker { border: 2px solid var(--r-accent); color: var(--r-accent); }
    .rq .step.bad .marker { background: var(--r-bad); border-color: var(--r-bad); color: var(--r-card); }
    .rq .step.off .marker { background: var(--r-tint); border-color: #8f9a96; color: var(--r-muted); }
    .rq .step.skip .step-title, .rq .step.skip .step-text, .rq .step.todo .step-title { color: var(--r-muted); }
    .rq .step-title { display: block; font-weight: 700; }
    .rq .step-text { display: block; margin-top: .15rem; color: var(--r-muted); font-size: 1rem; line-height: 1.45; }

    /* Detail rows */
    .rq .section-bar { padding: .85rem 1.5rem; background: var(--r-tint); border-top: 1px solid var(--r-line); border-bottom: 1px solid var(--r-line); }
    .rq dl { margin: 0; }
    .rq .row-item { display: grid; grid-template-columns: 14rem 1fr; gap: 1rem; padding: .9rem 1.5rem; border-bottom: 1px solid var(--r-line); }
    .rq .row-item:last-child { border-bottom: 0; }
    .rq dt { font-weight: 400; color: var(--r-muted); }
    .rq dd { margin: 0; font-weight: 600; overflow-wrap: anywhere; }
    .rq .prose { font-weight: 400; line-height: 1.65; white-space: pre-line; }
    .rq .mono { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 1rem; }
    .rq .copy { margin-left: .75rem; padding: .1rem .6rem; border: 1px solid #b4bbb9; border-radius: 3px; background: var(--r-card);
                color: var(--r-accent); font-size: .92rem; font-weight: 600; cursor: pointer; }
    .rq .copy:hover { border-color: var(--r-accent); }

    /* Sidebar */
    .rq .side { position: sticky; top: 5rem; display: grid; gap: 1.5rem; }
    .rq .box { padding: 1.4rem 1.5rem; }
    .rq .box h2 { margin-bottom: .9rem; }
    .rq .side-row { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; padding: .65rem 0; border-bottom: 1px solid var(--r-line); }
    .rq .side-row:first-of-type { border-top: 1px solid var(--r-line); }
    .rq .side-row:last-child { border-bottom: 0; }
    .rq .side-row > span:first-child { color: var(--r-muted); }
    .rq .side-row .val { text-align: right; font-weight: 600; overflow-wrap: anywhere; }
    .rq .side-row small { display: block; color: var(--r-muted); font-weight: 400; }
    .rq .help { margin: 0 0 1.1rem; color: var(--r-muted); line-height: 1.55; }
    .rq .stack { display: grid; gap: .6rem; }
    .rq .stack form { margin: 0; }

    .rq .btn-medical, .rq .btn-reject, .rq .btn-quiet, .rq .btn-danger-solid {
        display: block; width: 100%; padding: .65rem 1rem; font-size: 1.0625rem; font-weight: 600; text-align: center;
        border-radius: 4px; cursor: pointer;
    }
    .rq .btn-reject { background: transparent; color: var(--r-bad); border: 1px solid var(--r-bad); }
    .rq .btn-reject:hover { background: var(--r-bad); color: var(--r-card); }
    .rq .btn-quiet { background: transparent; color: var(--r-ink); border: 1px solid var(--r-ink); }
    .rq .btn-quiet:hover { background: var(--r-ink); color: var(--r-card); }
    .rq .btn-danger-solid { background: var(--r-bad); color: var(--r-card); border: 1px solid var(--r-bad); }
    .rq .btn-danger-solid:hover { background: #8a2a2a; border-color: #8a2a2a; }
    .rq button:disabled { opacity: .65; cursor: progress; }

    .rq a:focus-visible, .rq button:focus-visible { outline: 2px solid var(--r-accent); outline-offset: 2px; }

    /* Confirmation modal */
    .rq .modal-content { background: var(--r-card); border: 1px solid var(--r-line); border-top: 3px solid var(--r-accent); border-radius: 4px; }
    .rq .modal-header { border-bottom: 1px solid var(--r-line); padding: 1.1rem 1.5rem; }
    .rq .modal-title { font-size: 1.25rem; font-weight: 700; }
    .rq .modal-body { padding: 1.25rem 1.5rem; line-height: 1.6; color: var(--r-ink); }
    .rq .modal-footer { border-top: 1px solid var(--r-line); background: var(--r-tint); padding: .9rem 1.5rem; gap: .6rem; }
    .rq .modal-footer .btn-quiet, .rq .modal-footer .btn-medical, .rq .modal-footer .btn-danger-solid { width: auto; min-width: 8rem; margin: 0; }

    @@media (max-width: 991.98px) {
        .rq .side { position: static; }
    }
    @@media (max-width: 767.98px) {
        .rq h1 { font-size: 1.6rem; }
        .rq .flow { grid-template-columns: 1fr; gap: 1rem; padding: 1.25rem 1rem; }
        .rq .flow-mid { min-width: 0; }
        .rq .flow-arrow { width: 2px; height: 30px; margin: .6rem auto; }
        .rq .flow-arrow::after { right: -5px; top: auto; bottom: 0; transform: rotate(135deg); }
        .rq .stepper { grid-template-columns: 1fr; }
        .rq .step { border-right: 0; border-bottom: 1px solid var(--r-line); }
        .rq .step:last-child { border-bottom: 0; }
        .rq .row-item { grid-template-columns: 1fr; gap: .1rem; padding-left: 1rem; padding-right: 1rem; }
        .rq .section-bar { padding-left: 1rem; padding-right: 1rem; }
    }
    @@media (min-width: 768px) {
        .rq .page-head { flex-direction: row; justify-content: space-between; align-items: flex-end; }
    }
</style>

<div class="rq">

    <a href="javascript:history.back()" class="back" aria-label="Go back">&larr; Back</a>

    <div class="page-head">
        <div>
            <span class="eyebrow">Transfer request</span>
            <h1>@Model.TradeName</h1>
            <p class="lead-text">Request details and transfer information.</p>
        </div>

        <div>
            <span class="tag big @requestStatusClass">@requestStatusText</span>
        </div>
    </div>

    <div class="row g-4">

        <!-- Main -->
        <div class="col-lg-8 order-2 order-lg-1">

            <div class="panel @requestStatusClass">

                <!-- Seller to buyer -->
                <div class="flow">
                    <div class="party">
                        <span class="party-role">Seller &middot; @sellerRole</span>
                        <span class="party-name">@Model.SellerUserName</span>
                    </div>

                    <div class="flow-mid">
                        <span class="flow-price">@Model.AskingPrice.ToString("N2") <small>EGP</small></span>
                        <span class="flow-arrow" aria-hidden="true"></span>
                        <span class="flow-cap">Asking price</span>
                    </div>

                    <div class="party buyer">
                        <span class="party-role">Buyer &middot; @buyerRole</span>
                        <span class="party-name">@Model.BuyerUserName</span>
                    </div>
                </div>

                <!-- Progress -->
                <div class="stepper">
                    <div class="step done">
                        <span class="marker" aria-hidden="true">@Mark("done", 1)</span>
                        <span class="step-title">Requested</span>
                        <span class="step-text">@Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")</span>
                    </div>
                    <div class="step @step2State">
                        <span class="marker" aria-hidden="true">@Mark(step2State, 2)</span>
                        <span class="step-title">Decision</span>
                        <span class="step-text">@step2Text</span>
                    </div>
                    <div class="step @step3State">
                        <span class="marker" aria-hidden="true">@Mark(step3State, 3)</span>
                        <span class="step-title">Transfer</span>
                        <span class="step-text">@step3Text</span>
                    </div>
                </div>

                <!-- License -->
                <div class="section-bar"><h2>License involved</h2></div>
                <dl>
                    <div class="row-item">
                        <dt>License status</dt>
                        <dd><span class="tag @licenseStatusClass">@licenseStatusText</span></dd>
                    </div>
                    <div class="row-item">
                        <dt>License category</dt>
                        <dd>@(Model.LicenseCategory?.ToString() ?? "Not specified")</dd>
                    </div>
                    <div class="row-item">
                        <dt>Registration number</dt>
                        <dd>
                            <span id="registrationNumber" class="mono">@Model.RegistrationNumber</span>
                            <button type="button" class="copy" data-copy-target="registrationNumber"
                                    aria-label="Copy registration number">Copy</button>
                        </dd>
                    </div>
                    <div class="row-item">
                        <dt>Dosage form</dt>
                        <dd>@Model.DosageForm</dd>
                    </div>
                    <div class="row-item">
                        <dt>Current owner company</dt>
                        <dd>@Model.CurrentOwnerCompany</dd>
                    </div>
                    <div class="row-item">
                        <dt>Issue date</dt>
                        <dd>@Model.IssueDate.ToString("dd MMMM yyyy")</dd>
                    </div>
                    <div class="row-item">
                        <dt>Expiry date</dt>
                        <dd>@Model.ExpiryDate.ToString("dd MMMM yyyy")</dd>
                    </div>
                    <div class="row-item">
                        <dt>Active ingredients</dt>
                        <dd class="prose">@Model.ActiveIngredients</dd>
                    </div>
                </dl>

            </div>

        </div>

        <!-- Sidebar: actions first on phones -->
        <div class="col-lg-4 order-1 order-lg-2">
            <div class="side">

                @if (Model.Status == RequestStatus.Pending)
                {
                    <div class="panel box">
                        <h2>Actions</h2>
                        <p class="help @(isSeller || isBuyer ? "" : "mb-0")">@(isSeller || isBuyer ? "Choose an action for this pending transfer request." : "Only the seller or the buyer can act on this request.")</p>

                        <div class="stack">

                            @if (isSeller)
                            {
                                <form asp-controller="UserRequest" asp-action="ApproveRequest"
                                      asp-route-requestId="@Model.Id"
                                      method="post"
                                      class="action-form"
                                      data-action="approve">
                                    <button type="submit" class="btn-medical">Approve transfer</button>
                                </form>

                                <form asp-controller="UserRequest" asp-action="RejectRequest"
                                      asp-route-requestId="@Model.Id"
                                      method="post"
                                      class="action-form"
                                      data-action="reject">
                                    <button type="submit" class="btn-reject">Reject request</button>
                                </form>
                            }

                            @if (isBuyer)
                            {
                                <form asp-controller="UserRequest" asp-action="CancelRequest"
                                      asp-route-requestId="@Model.Id"
                                      method="post"
                                      class="action-form"
                                      data-action="cancel">
                                    <button type="submit" class="btn-quiet">Cancel request</button>
                                </form>
                            }

                        </div>
                    </div>
                }
                else
                {
                    <div class="panel box @requestStatusClass">
                        <h2>Request @requestStatusText.ToLower()</h2>
                        <p class="help mb-0">This request no longer has any available actions.</p>
                    </div>
                }

                <div class="panel box">
                    <h2>Summary</h2>

                    <div class="side-row">
                        <span>Request status</span>
                        <span class="val"><span class="tag @requestStatusClass">@requestStatusText</span></span>
                    </div>
                    <div class="side-row">
                        <span>Requested on</span>
                        <span class="val">
                            @Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy")
                            <small>@Model.CreatedAt.ToLocalTime().ToString("hh:mm tt")</small>
                        </span>
                    </div>
                    <div class="side-row">
                        <span>Request ID</span>
                        <span class="val mono">@Model.Id</span>
                    </div>
                </div>

            </div>
        </div>

    </div>

    <!-- Confirmation modal -->
    <div class="modal fade" id="actionConfirmationModal" tabindex="-1" aria-labelledby="confirmationTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="confirmationTitle">Confirm action</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <p class="mb-0" id="confirmationMessage"></p>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn-quiet" data-bs-dismiss="modal">Go back</button>
                    <button type="button" id="confirmActionButton" class="btn-medical">Confirm</button>
                </div>

            </div>
        </div>
    </div>

</div>

@section Scripts {

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const confirmationModalElement = document.getElementById("actionConfirmationModal");
            const confirmationModal = new bootstrap.Modal(confirmationModalElement);
            const confirmationTitle = document.getElementById("confirmationTitle");
            const confirmationMessage = document.getElementById("confirmationMessage");
            const confirmActionButton = document.getElementById("confirmActionButton");

            let pendingForm = null;

            /* Confirmation modal */
            document.querySelectorAll(".action-form").forEach(function (form) {

                form.addEventListener("submit", function (event) {

                    event.preventDefault();

                    pendingForm = form;

                    const action = form.dataset.action;

                    if (action === "approve") {
                        confirmationTitle.textContent = "Approve transfer request";
                        confirmationMessage.textContent =
                            "Are you sure you want to approve this transfer request? Ownership of the license will be transferred to the buyer.";
                        confirmActionButton.className = "btn-medical";
                        confirmActionButton.textContent = "Approve";
                    }
                    else if (action === "reject") {
                        confirmationTitle.textContent = "Reject transfer request";
                        confirmationMessage.textContent =
                            "Are you sure you want to reject this transfer request? This action cannot be undone.";
                        confirmActionButton.className = "btn-danger-solid";
                        confirmActionButton.textContent = "Reject";
                    }
                    else if (action === "cancel") {
                        confirmationTitle.textContent = "Cancel transfer request";
                        confirmationMessage.textContent =
                            "Are you sure you want to cancel this transfer request?";
                        confirmActionButton.className = "btn-danger-solid";
                        confirmActionButton.textContent = "Cancel request";
                    }

                    confirmationModal.show();
                });
            });

            /* Confirm selected action */
            confirmActionButton.addEventListener("click", function () {

                if (!pendingForm) {
                    return;
                }

                const button = pendingForm.querySelector("button[type='submit']");

                if (button) {
                    button.disabled = true;
                    button.textContent = "Processing\u2026";
                }

                confirmationModal.hide();

                pendingForm.submit();
            });

            /* Copy registration number */
            document.querySelectorAll(".copy").forEach(function (button) {

                button.addEventListener("click", async function () {

                    const target = document.getElementById(button.dataset.copyTarget);

                    if (!target) {
                        return;
                    }

                    try {
                        await navigator.clipboard.writeText(target.textContent.trim());

                        const original = button.textContent;
                        button.textContent = "Copied";

                        setTimeout(function () {
                            button.textContent = original;
                        }, 1500);
                    }
                    catch (error) {
                        console.error("Unable to copy registration number:", error);
                    }
                });
            });
        });
    </script>
}
