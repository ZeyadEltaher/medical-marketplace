@model Medical.BLL.ViewModels.Account.AddPasswordViewModel

@{
    ViewData["Title"] = "Set Password";
    ViewData["LayoutMode"] = "Auth";
}

<style>
    .auth {
        --a-ink: var(--medical-dark, #1c2733);
        --a-muted: var(--medical-muted, #4f5b66);
        --a-line: var(--medical-border, #d4d6cf);
        --a-accent: var(--medical-primary, #1d5c63);
        --a-error: #a63232;

        width: 100%;
        max-width: 26rem;
        margin: 0 auto;
        color: var(--a-ink);
    }

    .auth .card-custom {
        border-top: 3px solid var(--a-accent);
        padding: 1.5rem 1.75rem;
    }

    .auth h1 {
        font-size: 1.4rem;
        font-weight: 700;
        letter-spacing: -.01em;
        margin: 0 0 .3rem;
    }

    .auth .lead-text {
        color: var(--a-muted);
        margin: 0 0 1.1rem;
        font-size: .95rem;
    }

    .auth .field {
        margin-bottom: .8rem;
    }

    .auth label.field-label {
        display: block;
        margin-bottom: .3rem;
        font-weight: 600;
        font-size: .92rem;
    }

    .auth .form-control-custom {
        width: 100%;
        padding: .5rem .75rem;
    }

    .auth .field-error {
        display: block;
        margin-top: .25rem;
        color: var(--a-error);
        font-size: .85rem;
    }

    .auth .validation-summary-valid {
        display: none;
    }

    .auth .form-error {
        margin-bottom: .9rem;
        padding: .6rem .85rem;
        border: 1px solid #e3b9b9;
        border-left: 3px solid var(--a-error);
        border-radius: 4px;
        background: #f8ecec;
        color: #6f2222;
        font-size: .92rem;
    }

    .auth .form-error ul {
        margin: 0;
        padding-left: 1.1rem;
    }

    .auth .btn-medical {
        width: 100%;
        padding: .5rem 1rem;
    }

    .auth .switch-text {
        margin: 1rem 0 0;
        padding-top: .9rem;
        border-top: 1px solid var(--a-line);
        text-align: center;
        color: var(--a-muted);
        font-size: .92rem;
    }

    .auth .switch-text a {
        color: var(--a-accent);
        font-weight: 600;
        text-decoration: underline;
        text-underline-offset: 2px;
    }

    .auth .switch-text a:hover {
        color: var(--medical-primary-hover, #164a50);
    }

    @@media (max-height: 700px) {
        .auth .card-custom {
            padding: 1.1rem 1.5rem;
        }

        .auth h1 {
            margin-bottom: .9rem;
        }

        .auth .lead-text {
            display: none;
        }

        .auth .field {
            margin-bottom: .6rem;
        }

        .auth .switch-text {
            margin-top: .75rem;
            padding-top: .7rem;
        }
    }

    @@media (max-width: 575.98px) {
        .auth .card-custom {
            padding: 1.25rem;
        }
    }
</style>

<div class="auth">
    <div class="card card-custom">

        <h1>Set your password</h1>

        <p class="lead-text">
            Create a password so you can sign in with your email
            instead of using Google.
        </p>

        <form asp-action="AddPassword"
              asp-controller="Account"
              method="post"
              novalidate>

            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary-valid form-error">
            </div>

            <div class="field">
                <label asp-for="NewPassword" class="field-label">
                    New password
                </label>

                <input asp-for="NewPassword"
                       type="password"
                       class="form-control form-control-custom"
                       autocomplete="new-password"
                       placeholder="Enter your new password" />

                <span asp-validation-for="NewPassword"
                      class="field-error">
                </span>
            </div>

            <div class="field">
                <label asp-for="ConfirmPassword" class="field-label">
                    Confirm password
                </label>

                <input asp-for="ConfirmPassword"
                       type="password"
                       class="form-control form-control-custom"
                       autocomplete="new-password"
                       placeholder="Confirm your new password" />

                <span asp-validation-for="ConfirmPassword"
                      class="field-error">
                </span>
            </div>

            <button type="submit" class="btn btn-medical">
                Set Password
            </button>

        </form>

        <div class="switch-text">
            You can still sign in with Google after setting your password.
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}