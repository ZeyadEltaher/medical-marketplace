@model Medical.BLL.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    ViewData["LayoutMode"] = "Auth";
}

<style>
    .auth {
        --a-ink: var(--medical-dark, #1c2733);
        --a-muted: var(--medical-muted, #4f5b66);
        --a-line: var(--medical-border, #d4d6cf);
        --a-accent: var(--medical-primary, #1d5c63);
        --a-error: #a63232;
        width: 100%;
        max-width: 26rem;
        margin: 0 auto;
        color: var(--a-ink);
    }

    .auth .card-custom { border-top: 3px solid var(--a-accent); padding: 1.5rem 1.75rem; }

    .auth h1 { font-size: 1.4rem; font-weight: 700; letter-spacing: -.01em; margin: 0 0 .3rem; }
    .auth .lead-text { color: var(--a-muted); margin: 0 0 1.1rem; font-size: .95rem; }

    .auth .field { margin-bottom: .8rem; }
    .auth label.field-label { display: block; margin-bottom: .3rem; font-weight: 600; font-size: .92rem; }
    .auth .form-control-custom { width: 100%; padding: .5rem .75rem; }
    .auth .field-error { display: block; margin-top: .25rem; color: var(--a-error); font-size: .85rem; }

    /* Summary: hidden until the server returns an error */
    .auth .validation-summary-valid { display: none; }
    .auth .form-error {
        margin-bottom: .9rem; padding: .6rem .85rem;
        border: 1px solid #e3b9b9; border-left: 3px solid var(--a-error);
        border-radius: 4px; background: #f8ecec; color: #6f2222; font-size: .92rem;
    }
    .auth .form-error ul { margin: 0; padding-left: 1.1rem; }

    .auth .btn-medical, .auth .btn-outline-medical { width: 100%; padding: .5rem 1rem; }

    .auth .divider {
        display: flex; align-items: center; gap: .8rem;
        margin: 1rem 0 .85rem; color: var(--a-muted); font-size: .85rem;
    }
    .auth .divider::before, .auth .divider::after { content: ""; flex: 1; height: 1px; background: var(--a-line); }

    .auth .switch-text { margin: 1rem 0 0; padding-top: .9rem; border-top: 1px solid var(--a-line);
                         text-align: center; color: var(--a-muted); font-size: .92rem; }
    .auth .switch-text a { color: var(--a-accent); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }
    .auth .switch-text a:hover { color: var(--medical-primary-hover, #164a50); }

    .auth .form-check { margin: 0 0 1rem; }
    .auth .form-check-input { border-color: #8f9a96; }
    .auth .form-check-input:checked { background-color: var(--a-accent); border-color: var(--a-accent); }
    .auth .form-check-input:focus { border-color: var(--a-accent); box-shadow: 0 0 0 3px rgba(29, 92, 99, .18); }
    .auth .form-check-label { font-size: .92rem; color: var(--a-muted); }

    /* Short screens (small laptops, high zoom): tighten further so nothing scrolls */
    @@media (max-height: 700px) {
        .auth .card-custom { padding: 1.1rem 1.5rem; }
        .auth h1 { margin-bottom: .9rem; }
        .auth .lead-text { display: none; }
        .auth .field { margin-bottom: .6rem; }
        .auth .form-check { margin-bottom: .75rem !important; }
        .auth .divider { margin: .75rem 0 .65rem; }
        .auth .switch-text { margin-top: .75rem; padding-top: .7rem; }
    }
    @@media (max-width: 575.98px) {
        .auth .card-custom { padding: 1.25rem; }
    }
</style>

<div class="auth">
    <div class="card card-custom">

        <h1>Sign in</h1>
        <p class="lead-text">Use your email and password to access your account.</p>

        <form asp-action="Login"
              asp-controller="Account"
              asp-route-returnUrl="@Context.Request.Query["returnUrl"]"
              method="post" novalidate>

            <div asp-validation-summary="ModelOnly" class="form-error" role="alert"></div>

            <div class="field">
                <label asp-for="Email" class="field-label">Email</label>
                <input asp-for="Email" class="form-control form-control-custom"
                       placeholder="name@example.com" autocomplete="username" autofocus />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>

            <div class="field">
                <label asp-for="Password" class="field-label">Password</label>
                <input asp-for="Password" type="password" class="form-control form-control-custom"
                       autocomplete="current-password" />
                <span asp-validation-for="Password" class="field-error"></span>
            </div>

            <div class="form-check">
                <input asp-for="RememberMe" class="form-check-input" type="checkbox" />
                <label asp-for="RememberMe" class="form-check-label">Remember me</label>
            </div>

            <button type="submit" class="btn btn-medical">Sign in</button>
        </form>

        <div class="divider">or</div>

        <form asp-action="ExternalLogin"
              asp-controller="Account"
              asp-route-returnUrl="@Context.Request.Query["returnUrl"]"
              method="post">
            <input type="hidden" name="provider" value="Google" />
            <button type="submit" class="btn btn-outline-medical">Continue with Google</button>
        </form>

        <p class="switch-text">
            Don't have an account?
            <a asp-action="Register"
               asp-controller="Account"
               asp-route-returnUrl="@Context.Request.Query["returnUrl"]">Create an account</a>
        </p>

    </div>
</div>
